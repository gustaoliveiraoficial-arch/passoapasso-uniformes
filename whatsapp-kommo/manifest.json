{
  "manifest_version": 3,
  "name": "WhatsApp Kommo Bridge — Passo a Passo",
  "version": "2.0.0",
  "description": "Integra WhatsApp Web com o CRM Kommo. Kanban sincronizado, filtros por etapa e mova leads direto do WhatsApp.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.kommo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
