{
  "manifest_version": 3,
  "name": "Kommo Chat Pro — Passo a Passo",
  "version": "1.0.0",
  "description": "Interface de chat simplificada para o Kommo. Oculta campos CRM desnecessários e expande a área de conversa.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.kommo.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.kommo.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
