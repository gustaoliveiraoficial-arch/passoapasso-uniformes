[
  {
    "origin": ["*"],
    "method": ["GET", "PUT", "POST", "DELETE", "HEAD", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "Content-Length",
      "User-Agent",
      "x-goog-resumable",
      "x-goog-meta-firebasestoragedownloadtokens",
      "Access-Control-Allow-Origin"
    ],
    "maxAgeSeconds": 3600
  }
]
